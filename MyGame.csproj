<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Disable SDK auto-generation of assembly attributes so we can supply a single AssemblyInfo.cs
         This prevents duplicate-attribute (CS0579) errors when stale obj/ artifacts exist. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>MonoRogue</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="RogueSharp" Version="4.2.0" />
    <PackageReference Include="SadConsole.Host.MonoGame" Version="10.10.0" />
    <PackageReference Include="SadConsole.Extended" Version="10.10.0" />
  </ItemGroup>
  

</Project>
